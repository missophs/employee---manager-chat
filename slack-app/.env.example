# Copy this file to .env and paste your real tokens in.
# .env is in .gitignore. Never commit real tokens, never paste them into chat.

# Bot User OAuth Token — starts with xoxb-
# Where: api.slack.com/apps → your app → OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-your-token-here

# App-Level Token — starts with xapp-
# Where: api.slack.com/apps → your app → Basic Information → App-Level Tokens
#        Generate one with the connections:write scope
SLACK_APP_TOKEN=xapp-your-token-here

# Where the "Open Performance Pulse" buttons point.
APP_URL=https://missophs.github.io/employee---manager-chat/
HANDBOOK_URL=
